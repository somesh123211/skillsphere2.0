# Ignore virtual environment
venv/

# Ignore caches and system files
__pycache__/
*.pyc
*.pyo
*.log
*.sqlite3
.DS_Store

# Ignore environment variables and configs
.env

# Machine-local TLS trust workaround (e.g. antivirus HTTPS-scanning root
# cert) - not portable between machines, same reasoning as .env above.
certs/

# Ignore nested git repo
backend_flask/.git/
